---
// 사이드바를 열고 닫는 버튼. 상태는 localStorage 에 저장되고
// 닫힌 상태에서는 화면 왼쪽 끝에 마우스를 올리면 잠깐 미리 볼 수 있습니다.
---

<button
  class="sidebar-toggle"
  type="button"
  id="sidebar-toggle"
  aria-controls="sidebar-slot"
  aria-label="카테고리 사이드바 열고 닫기"
  title="카테고리 사이드바 (\)"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
    <path d="M9.5 4v16"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.getElementById('sidebar-toggle');

  const isOpen = () => root.dataset.sidebar !== 'closed';

  const sync = () => button?.setAttribute('aria-expanded', String(isOpen()));

  function setOpen(open: boolean) {
    root.dataset.sidebar = open ? 'open' : 'closed';
    try {
      localStorage.setItem('sidebar', open ? 'open' : 'closed');
    } catch {
      /* 저장 실패는 무시 */
    }
    sync();
  }

  sync();
  button?.addEventListener('click', () => setOpen(!isOpen()));

  // 입력 중이 아닐 때 \ 키로도 여닫을 수 있게 합니다.
  document.addEventListener('keydown', (event) => {
    if (event.key !== '\\' || event.metaKey || event.ctrlKey || event.altKey) return;

    const target = event.target as HTMLElement | null;
    if (target?.closest('input, textarea, select, [contenteditable]')) return;

    event.preventDefault();
    setOpen(!isOpen());
  });
</script>
