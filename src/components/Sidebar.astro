---
import CategoryTree from './CategoryTree.astro';
import { url } from '../consts';
import { getPublishedPosts, buildCategoryTree, groupByTag } from '../utils/posts';

interface Props {
  /** 글 상세처럼 URL 로는 알 수 없을 때 현재 카테고리를 직접 알려줍니다. */
  activeSlug?: string;
}

const posts = await getPublishedPosts();
const tree = buildCategoryTree(posts);
const tagCount = groupByTag(posts).length;

// prop 이 없으면 /categories/... 주소에서 직접 뽑아냅니다.
const prefix = url('/categories/');
const pathname = decodeURIComponent(Astro.url.pathname);
const fromUrl = pathname.startsWith(prefix)
  ? pathname.slice(prefix.length).replace(/\/+$/, '')
  : '';

const activeSlug = Astro.props.activeSlug ?? fromUrl;
---

<aside class="sidebar" aria-label="카테고리">
  <nav class="sidebar__section">
    <p class="sidebar__heading">카테고리</p>
    {
      tree.length > 0 ? (
        <CategoryTree nodes={tree} activeSlug={activeSlug} />
      ) : (
        <p class="sidebar__empty">아직 카테고리가 없습니다.</p>
      )
    }
  </nav>

  <nav class="sidebar__section sidebar__links">
    <a href={url('/posts')}>
      전체 글 <span class="tree__count">{posts.length}</span>
    </a>
    <a href={url('/tags')}>
      태그 <span class="tree__count">{tagCount}</span>
    </a>
  </nav>
</aside>

<script>
  // 접었다 편 상태를 카테고리별로 기억합니다.
  const KEY = 'sidebar-tree';

  const readState = (): Record<string, boolean> => {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? '{}');
    } catch {
      return {};
    }
  };

  const state = readState();

  for (const branch of document.querySelectorAll<HTMLDetailsElement>('.tree__branch')) {
    const path = branch.dataset.path;
    if (!path) continue;

    // 지금 보고 있는 카테고리로 가는 길목은 저장값과 상관없이 열어둡니다.
    if (branch.dataset.autoOpen !== 'true' && path in state) {
      branch.open = state[path];
    }

    branch.addEventListener('toggle', () => {
      state[path] = branch.open;
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {
        /* 저장 실패는 무시 */
      }
    });
  }

  // 카테고리 이름을 눌렀을 때는 펼침 토글 없이 그대로 이동시킵니다.
  for (const link of document.querySelectorAll('.tree__row > .tree__link')) {
    link.addEventListener('click', (event) => event.stopPropagation());
  }

  // ------------------------------------------------------------
  //  닫힌 상태에서의 호버 미리보기
  //  - 마우스를 올리면 곧바로 나타납니다 (지연 없음)
  //  - 마우스를 떼면 300ms 뒤에 사라집니다 (실수로 스쳐도 안 닫히게)
  //  - 버튼으로 닫을 때는 이 로직과 무관하게 즉시 닫힙니다
  // ------------------------------------------------------------
  const slot = document.getElementById('sidebar-slot');

  if (slot) {
    let hideTimer: number | undefined;

    const peek = () => {
      window.clearTimeout(hideTimer);
      slot.classList.add('is-peeking');
    };

    const unpeek = () => {
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => slot.classList.remove('is-peeking'), 300);
    };

    slot.addEventListener('mouseenter', peek);
    slot.addEventListener('mouseleave', unpeek);
    slot.addEventListener('focusin', peek);
    slot.addEventListener('focusout', unpeek);
  }
</script>
