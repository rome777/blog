---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../consts';
import { getPublishedPosts, groupByCategory } from '../../utils/posts';

const posts = await getPublishedPosts();
const categories = groupByCategory(posts);
---

<BaseLayout title="카테고리" description="주제별로 학습 기록을 모아봅니다.">
  <div class="section-head">
    <h2>카테고리</h2>
    <span class="muted">{categories.length}개</span>
  </div>

  {
    categories.length === 0 ? (
      <p class="empty">아직 카테고리가 없습니다.</p>
    ) : (
      <div class="card-grid">
        {categories.map((category) => (
          <a class="card" href={url(`/categories/${category.slug}`)}>
            <p class="card__title">{category.name}</p>
            <span class="card__meta">{category.posts.length}개의 글</span>
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>
