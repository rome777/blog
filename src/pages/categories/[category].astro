---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { url } from '../../consts';
import { getPublishedPosts, groupByCategory } from '../../utils/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return groupByCategory(posts).map((category) => ({
    params: { category: category.slug },
    props: { name: category.name, posts: category.posts },
  }));
};

const { name, posts } = Astro.props;
---

<BaseLayout title={name} description={`'${name}' 카테고리의 글 ${posts.length}개.`}>
  <div class="section-head">
    <h2>{name}</h2>
    <a href={url('/categories')}>← 전체 카테고리</a>
  </div>

  <PostList posts={posts} groupByYear />
</BaseLayout>
