---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagRow from '../../components/TagRow.astro';
import { getPublishedPosts, groupByTag, toCountMap } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = groupByTag(posts);
---

<BaseLayout title="태그" description="태그별로 학습 기록을 모아봅니다.">
  <div class="section-head">
    <h2>태그</h2>
    <span class="muted">{tags.length}개</span>
  </div>

  {
    tags.length === 0 ? (
      <p class="empty">아직 태그가 없습니다.</p>
    ) : (
      <TagRow tags={tags.map((t) => t.name)} counts={toCountMap(tags)} class="tag-cloud" />
    )
  }
</BaseLayout>
