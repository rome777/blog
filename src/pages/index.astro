---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import TagRow from '../components/TagRow.astro';
import { url, SITE_DESCRIPTION } from '../consts';
import { getPublishedPosts, groupByCategory, groupByTag, toCountMap } from '../utils/posts';

const posts = await getPublishedPosts();
const recent = posts.slice(0, 5);
const categories = groupByCategory(posts);
const tags = groupByTag(posts).slice(0, 20);
---

<BaseLayout description={SITE_DESCRIPTION}>
  <section class="hero">
    <h1>배운 것을 기록합니다</h1>
    <p>{SITE_DESCRIPTION}</p>
  </section>

  <div class="stack-lg">
    <section>
      <div class="section-head">
        <h2>최근 글</h2>
        <a href={url('/posts')}>전체 {posts.length}개 →</a>
      </div>
      <PostList posts={recent} emptyText="첫 글을 기다리는 중입니다." />
    </section>

    {
      categories.length > 0 && (
        <section>
          <div class="section-head">
            <h2>카테고리</h2>
          </div>
          <div class="card-grid">
            {categories.map((category) => (
              <a class="card" href={url(`/categories/${category.slug}`)}>
                <p class="card__title">{category.name}</p>
                <span class="card__meta">{category.posts.length}개의 글</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      tags.length > 0 && (
        <section>
          <div class="section-head">
            <h2>태그</h2>
            <a href={url('/tags')}>모두 보기 →</a>
          </div>
          <TagRow
            tags={tags.map((tag) => tag.name)}
            counts={toCountMap(tags)}
            class="tag-cloud"
          />
        </section>
      )
    }
  </div>
</BaseLayout>
