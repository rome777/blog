---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { POSTS_PER_PAGE } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const pageItems = posts.slice(0, POSTS_PER_PAGE);
const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
---

<BaseLayout title="전체 글" description="지금까지 쓴 학습 기록 전체 목록입니다.">
  <div class="section-head">
    <h2>전체 글</h2>
    <span class="muted">{posts.length}개</span>
  </div>

  <PostList posts={pageItems} groupByYear />

  <Pagination current={1} last={lastPage} />
</BaseLayout>
