---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import Pagination from '../../../components/Pagination.astro';
import { POSTS_PER_PAGE } from '../../../consts';
import { getPublishedPosts } from '../../../utils/posts';

// 1페이지는 /posts 가 담당하므로 여기서는 2페이지부터 생성합니다.
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  const last = Math.ceil(posts.length / POSTS_PER_PAGE);

  return Array.from({ length: Math.max(0, last - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: {
        items: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
        page,
        last,
        total: posts.length,
      },
    };
  });
};

const { items, page, last, total } = Astro.props;
---

<BaseLayout title={`전체 글 (${page}페이지)`} description="지금까지 쓴 학습 기록 전체 목록입니다.">
  <div class="section-head">
    <h2>전체 글</h2>
    <span class="muted">{total}개</span>
  </div>

  <PostList posts={items} groupByYear />

  <Pagination current={page} last={last} />
</BaseLayout>
