---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TagRow from '../components/TagRow.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import { url, slugify, categorySegments, formatDate, isoDate, readingTime } from '../consts';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}

const { post, headings, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, heroImage } = post.data;

// '딥러닝/CNN' → 단계마다 링크를 걸 수 있게 조각을 만들어 둡니다.
const segments = categorySegments(category);
const trail = segments.map((name, index) => ({
  name,
  slug: segments.slice(0, index + 1).map(slugify).join('/'),
}));
const activeCategory = trail.at(-1)?.slug;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  activeCategory={activeCategory}
>
  <article>
    <header class="post-header">
      <nav class="crumbs" aria-label="카테고리">
        {
          trail.map((crumb, index) => (
            <Fragment>
              {index > 0 && <span aria-hidden="true">/</span>}
              <a
                class={index === trail.length - 1 ? 'badge' : undefined}
                href={url(`/categories/${crumb.slug}`)}
              >
                {crumb.name}
              </a>
            </Fragment>
          ))
        }
      </nav>
      <h1>{title}</h1>
      {description && <p class="post-header__desc">{description}</p>}

      <div class="post-header__meta">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>읽는 데 약 {readingTime(post.body ?? '')}분</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>수정 {formatDate(updatedDate)}</span>
            </>
          )
        }
      </div>
    </header>

    {
      heroImage && (
        <div class="post-hero">
          <img src={url(heroImage)} alt={title} />
        </div>
      )
    }

    <TableOfContents headings={headings} />

    <div class="prose">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <footer class="post-footer">
          <TagRow tags={tags} />
        </footer>
      )
    }
  </article>

  <nav class="post-nav" aria-label="이전 / 다음 글">
    {
      prev && (
        <a class="post-nav__link" href={url(`/posts/${prev.id}`)}>
          <span class="post-nav__label">← 이전 글</span>
          <span class="post-nav__title">{prev.data.title}</span>
        </a>
      )
    }
    {
      next && (
        <a class="post-nav__link is-next" href={url(`/posts/${next.id}`)}>
          <span class="post-nav__label">다음 글 →</span>
          <span class="post-nav__title">{next.data.title}</span>
        </a>
      )
    }
  </nav>

  <Comments />
</BaseLayout>

<style is:global>
  /* 머메이드 다이어그램 — 넓어도 페이지 가로 스크롤을 만들지 않게 가둔다. */
  .mermaid-figure {
    margin: 1.5rem 0;
    overflow-x: auto;
    max-width: 100%;
  }
  .mermaid-figure svg {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    height: auto;
  }
</style>

<script is:inline type="module">
  // ```mermaid 코드블록을 다이어그램으로 바꾼다.
  // Shiki 가 먼저 하이라이트해 둔 <pre data-language="mermaid"> 에서 원문을 되살린다.
  const blocks = [...document.querySelectorAll('pre[data-language="mermaid"]')];

  if (blocks.length > 0) {
    const mermaid = (
      await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
    ).default;

    // 원문을 먼저 다 걷어 둔다. 렌더가 DOM 을 갈아 끼우기 때문이다.
    const sources = blocks.map((pre) => pre.textContent ?? '');
    const figures = blocks.map((pre) => {
      const figure = document.createElement('figure');
      figure.className = 'mermaid-figure';
      pre.replaceWith(figure);
      return figure;
    });

    const draw = async () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      mermaid.initialize({
        startOnLoad: false,
        theme: dark ? 'dark' : 'default',
        fontFamily: 'inherit',
        securityLevel: 'strict',
      });
      for (const [i, code] of sources.entries()) {
        try {
          const { svg } = await mermaid.render(`mermaid-${i}-${Date.now()}`, code);
          figures[i].innerHTML = svg;
        } catch (err) {
          // 문법이 틀렸으면 조용히 비우지 않고 원문을 그대로 보여 준다.
          figures[i].innerHTML = '';
          const pre = document.createElement('pre');
          pre.textContent = code;
          figures[i].append(pre);
        }
      }
    };

    await draw();

    // 라이트/다크를 바꾸면 다이어그램 색도 따라가야 한다.
    new MutationObserver(draw).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }
</script>
