---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_LANG } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** 목록 페이지처럼 넓게 쓰고 싶을 때 */
  wide?: boolean;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** 사이드바에서 펼쳐둘 카테고리 슬러그 (글 상세에서 넘겨줍니다) */
  activeCategory?: string;
}

const {
  title,
  description,
  wide = false,
  type,
  publishedTime,
  modifiedTime,
  activeCategory,
} = Astro.props;
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <BaseHead
      title={title}
      description={description}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
  </head>
  <body>
    <Header />

    <div class="shell">
      <div class="sidebar-slot" id="sidebar-slot">
        <Sidebar activeSlug={activeCategory} />
        <!-- 사이드바가 닫혔을 때 마우스를 올리면 잠깐 미리 보이는 영역 (넓은 화면) -->
        <div class="sidebar-peek" aria-hidden="true"><span class="sidebar-peek__grip"></span></div>
      </div>

      <!-- 좁은 화면에서 사이드바가 오버레이로 열렸을 때 바깥을 눌러 닫는 영역 -->
      <div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

      <main>
        <div class:list={['container', wide && 'wide']}>
          <slot />
        </div>
      </main>
    </div>

    <Footer />
  </body>
</html>
